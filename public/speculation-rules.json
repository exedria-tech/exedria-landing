{
  "prerender": [
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/api/*" } },
          { "not": { "href_matches": "/media/*" } },
          { "not": { "selector_matches": "[data-lang]" } }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
